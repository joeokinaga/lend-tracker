{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lend-tracker",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhook/*"]
  },
  "observability": {
    "enabled": true
  }
}
